# ১. Ubuntu 22.04 LTS Cloud Image ডাউনলোড
wget https://cloud-images.ubuntu.com/releases/22.04/release/ubuntu-22.04-server-cloudimg-amd64.img

# ২. ৯০০০ ID দিয়ে একটি খালি VM তৈরি
qm create 9000 --name "ubuntu-2204-cloudinit-template" --memory 2048 --cores 2 --net0 virtio,bridge=vmbr0

# ৩. ইমেজটি Proxmox Storage-এ Import করা (local-lvm এর জায়গায় আপনার স্টোরেজ নাম দিন)
qm importdisk 9000 ubuntu-2204-cloudinit-template.img local-lvm

# ৪. ডিস্ক যুক্ত করা এবং Cloud-Init ড্রাইভ কনফিগার করা
qm set 9000 --scsihw virtio-scsi-pci --scsi0 local-lvm:vm-9000-disk-0
qm set 9000 --ide2 local-lvm:cloudinit
qm set 9000 --boot c --bootdisk scsi0
qm set 9000 --serial0 socket --vga serial0

# ৫. টেমপ্লেটে রূপান্তর করা
qm template 9000